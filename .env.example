# Docker Hub 用户名（拉取预构建镜像时设置）
DOCKERHUB_USERNAME=

# Django CSRF 受信域名（逗号分隔多个）
# 示例：http://192.168.5.10:8080,https://your-domain.com
CSRF_TRUSTED_ORIGINS=http://192.168.5.10:8080

# 数据库
DB_PASSWORD=django_manage_secret

# 管理员账号（首次启动自动创建，已存在则跳过）
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=admin123

# MCP 鉴权（不设则跳过鉴权）
MCP_API_KEY=

# Nginx 对外端口
NGINX_PORT=80
