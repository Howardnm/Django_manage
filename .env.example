# ==============================================================================
# Django Manage — 环境变量配置模板（脱敏版）
# ==============================================================================
# 使用方法：
#   1. cp .env.example .env
#   2. 编辑 .env 填入真实值
#   3. NEVER commit .env to version control（已在 .gitignore 中排除）
#
# 所有敏感值留空，部署前必须根据实际环境填写。

# ==============================================================================
# 1. 核心安全（必填）
# ==============================================================================

# Django SECRET_KEY — 生成命令：
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=
# 调试模式 — 生产环境必须设为 False
DEBUG=True
# 允许访问的主机名/IP，逗号分隔。仅开发环境使用 '*'
ALLOWED_HOSTS=*

# ==============================================================================
# 2. CSRF 受信域名
# ==============================================================================

# 逗号分隔的受信域名列表
# 示例：http://192.168.5.10:8080,https://your-domain.com
CSRF_TRUSTED_ORIGINS=

# ==============================================================================
# 3. 数据库（默认 PostgreSQL）
# ==============================================================================

DB_ENGINE=django.db.backends.postgresql
DB_NAME=django_manage
DB_USER=postgres
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

# ==============================================================================
# 4. 注册
# ==============================================================================

# 注册页面邀请码，留空则关闭注册入口
REGISTER_INVITE_CODE=

# 登录页邮箱后缀快捷选择（逗号分隔，供下拉框选择；留空则仅显示"自定义域名"）
# 示例：EMAIL_DOMAINS=sunwill.com.cn,163.com,qq.com
EMAIL_DOMAINS=sunwill.com.cn

# ==============================================================================
# 5. 邮件（SMTP）
# ==============================================================================

# 示例（163邮箱）：
#   EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
#   EMAIL_HOST=smtp.163.com
#   EMAIL_PORT=994
#   EMAIL_USE_SSL=True
#   EMAIL_HOST_USER=your-email@163.com
#   EMAIL_HOST_PASSWORD=your-smtp-auth-code
EMAIL_BACKEND=
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USE_SSL=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# 默认发件人（留空则回退为 EMAIL_HOST_USER）
DEFAULT_FROM_EMAIL=

# ==============================================================================
# 6. 防暴力破解（django-axes）
# ==============================================================================

AXES_FAILURE_LIMIT=5
# 锁定时间（小时），0.0833 ≈ 5 分钟
AXES_COOLOFF_TIME=0.0833
AXES_RESET_ON_SUCCESS=True

# ==============================================================================
# 7. 内部系统集成
# ==============================================================================

# 主系统对外接口通信 Token（两方必须一致）
INTERNAL_API_TOKEN=
# 主系统对外接口基础地址（结尾需带斜杠）
# 示例：http://127.0.0.1:8000/api/external/
EXTERNAL_API_BASE_URL=
# 电子手册侧本地 worker 内存缓存：轮询主系统数据版本号的间隔（秒）
CATALOG_CACHE_VERSION_CHECK_INTERVAL=5
# 对外接口请求超时（秒）
REMOTE_API_TIMEOUT=15

# ==============================================================================
# 8. SAP RFC 连接
# ==============================================================================

# SAP NW RFC SDK 库目录路径
# Windows 示例：D:\SAP_SDK\win-nwrfc750P_6-70002755\nwrfcsdk\lib
# Docker 环境自动设为 /opt/sap_nwrfcsdk/lib
SAP_LIB_PATH=
# SAP 应用服务器 IP 或主机名
SAP_HOST=
# SAP 系统编号（通常为 "00"）
SAP_SYSNR=00
# SAP 客户端号
SAP_CLIENT=400
# SAP 通信账号
SAP_USER=
# SAP 通信密码
SAP_PASSWORD=
# 语言代码（ZH=中文, EN=英文）
SAP_LANG=ZH
# 连接池：闲置连接最大存活时间（秒）
SAP_MAX_IDLE_SECONDS=300
# 连接池：失败重试次数
SAP_MAX_RETRIES=3
# 连接池：重试初始间隔（秒，每次翻倍）
SAP_RETRY_DELAY=1.0

# ==============================================================================
# 9. Django 管理员账号（Docker 首次启动自动创建）
# ==============================================================================

DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=

# ==============================================================================
# 10. MCP Server（AI 集成）
# ==============================================================================

# MCP 鉴权 API Key，留空则跳过鉴权
MCP_API_KEY=

# ==============================================================================
# 11. Docker / 部署
# ==============================================================================

# Docker Hub 用户名（拉取预构建镜像时需要）
DOCKERHUB_USERNAME=
# Nginx 对外端口（建议 8080，避免与宿主机端口冲突）
NGINX_PORT=8080
