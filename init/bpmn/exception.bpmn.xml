<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
  id="Definitions_exception"
  targetNamespace="http://bpmn.io/schema/bpmn">

  <!-- 异常审批流程：异常说明 → 部门负责人审核 → 总监裁决 -->
  <bpmn:process id="exception_process" name="异常审批流程" isExecutable="true">

    <bpmn:startEvent id="StartEvent" name="发起异常报告">
      <bpmn:outgoing>Flow_to_reporter</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:userTask id="Task_reporter" name="异常说明"
        camunda:assignee="submitter"
        camunda:formStep="1" camunda:formStepLabel="描述异常">
      <bpmn:incoming>Flow_to_reporter</bpmn:incoming>
      <bpmn:outgoing>Flow_to_dept</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_dept_head" name="部门负责人审核"
        camunda:candidateGroups="dept_manager"
        camunda:formStep="2" camunda:formStepLabel="责任判定">
      <bpmn:incoming>Flow_to_dept</bpmn:incoming>
      <bpmn:outgoing>Flow_to_dir</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_dir_decision" name="总监裁决"
        camunda:assignee="rnd_dir"
        camunda:formStep="3" camunda:formStepLabel="最终裁决">
      <bpmn:incoming>Flow_to_dir</bpmn:incoming>
      <bpmn:outgoing>Flow_to_end</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:endEvent id="EndEvent" name="处理完成">
      <bpmn:incoming>Flow_to_end</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_to_reporter" sourceRef="StartEvent" targetRef="Task_reporter" />
    <bpmn:sequenceFlow id="Flow_to_dept" sourceRef="Task_reporter" targetRef="Task_dept_head" />
    <bpmn:sequenceFlow id="Flow_to_dir" sourceRef="Task_dept_head" targetRef="Task_dir_decision" />
    <bpmn:sequenceFlow id="Flow_to_end" sourceRef="Task_dir_decision" targetRef="EndEvent" />

  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="exception_process">
      <!-- Shapes — 从左到右水平排列 -->
      <bpmndi:BPMNShape id="StartEvent_di" bpmnElement="StartEvent">
        <dc:Bounds x="180" y="180" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_reporter_di" bpmnElement="Task_reporter">
        <dc:Bounds x="280" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_dept_head_di" bpmnElement="Task_dept_head">
        <dc:Bounds x="440" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_dir_decision_di" bpmnElement="Task_dir_decision">
        <dc:Bounds x="600" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_di" bpmnElement="EndEvent">
        <dc:Bounds x="760" y="182" width="36" height="36" />
      </bpmndi:BPMNShape>
      <!-- Edges -->
      <bpmndi:BPMNEdge id="Flow_to_reporter_di" bpmnElement="Flow_to_reporter">
        <di:waypoint x="216" y="198" />
        <di:waypoint x="280" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_to_dept_di" bpmnElement="Flow_to_dept">
        <di:waypoint x="380" y="200" />
        <di:waypoint x="440" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_to_dir_di" bpmnElement="Flow_to_dir">
        <di:waypoint x="540" y="200" />
        <di:waypoint x="600" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_to_end_di" bpmnElement="Flow_to_end">
        <di:waypoint x="700" y="200" />
        <di:waypoint x="760" y="200" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

</bpmn:definitions>
